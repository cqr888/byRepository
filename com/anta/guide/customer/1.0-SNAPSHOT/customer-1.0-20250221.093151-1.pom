<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.anta</groupId>
    <artifactId>framework-spring-dependency</artifactId>
    <version>2.2-SNAPSHOT</version>
  </parent>
  <groupId>com.anta.guide</groupId>
  <artifactId>customer</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>customer</name>
  <developers>
    <developer>
      <email>chenfengcong@anta.com</email>
    </developer>
  </developers>
  <modules>
    <module>customer-api</module>
    <module>customer-application</module>
    <module>customer-service</module>
    <module>wework-service</module>
    <module>label-service</module>
    <module>doris-service</module>
    <module>customer-springcloud-server</module>
  </modules>
  <properties>
    <spring-kafka.version>2.7.4</spring-kafka.version>
    <elasticsearch.version>7.10.2</elasticsearch.version>
    <rocket.version>2.2.3</rocket.version>
    <knife4j.version>3.0.3</knife4j.version>
    <redisson.version>3.18.0</redisson.version>
    <spring-data-elasticsearch.version>4.1.1</spring-data-elasticsearch.version>
    <revision>1.0-SNAPSHOT</revision>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>1.2.7</version>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten.clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
