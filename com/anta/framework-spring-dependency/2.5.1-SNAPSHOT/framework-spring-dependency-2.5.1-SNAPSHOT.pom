<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.anta</groupId>
	<artifactId>framework-spring-dependency</artifactId>
	<packaging>pom</packaging>
	<version>2.5.1-SNAPSHOT</version>

	<name>framework-spring-dependency</name>
	<description>ANTA Group Framework Parent Dependency with JDK 17</description>
	<url>http://www.anta.com</url>

	<developers>
		<developer>
			<id>zhanzhibin</id>
			<name>詹志彬</name>
			<email>zhanzhibin@ANATA.COM</email>
			<organization>ANTA GROUP</organization>
			<organizationUrl>https://www.anta.com</organizationUrl>
			<roles>
				<role>Developer</role>
			</roles>
		</developer>
		<developer>
			<id>chenfengcong</id>
			<name>陈逢聪</name>
			<email>陈逢聪@ANATA.COM</email>
			<organization>ANTA GROUP</organization>
			<organizationUrl>https://www.anta.com</organizationUrl>
			<roles>
				<role>Developer</role>
			</roles>
		</developer>
		<developer>
			<id>jiangxiaocan</id>
			<name>江晓灿</name>
			<email>江晓灿@ANATA.COM</email>
			<organization>ANTA GROUP</organization>
			<organizationUrl>https://www.anta.com</organizationUrl>
			<roles>
				<role>Developer</role>
			</roles>
		</developer>
		<developer>
			<id>yancaiyu</id>
			<name>颜彩瑜</name>
			<email>yancaiyu@ANATA.COM</email>
			<organization>ANTA GROUP</organization>
			<organizationUrl>https://www.anta.com</organizationUrl>
			<roles>
				<role>Developer</role>
			</roles>
		</developer>
	</developers>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<jdk.version>17</jdk.version>
		<spring-cloud.version>2021.0.3</spring-cloud.version>
		<spring-boot>2.7.2</spring-boot>
		<spring-mybatis>2.1.1</spring-mybatis>
		<mybatis.version>3.5.3</mybatis.version>
		<swagger-annotations.version>1.6.3</swagger-annotations.version>
		<springfox-swagger2>3.0.0</springfox-swagger2>
		<swagger-bootstrap-ui>1.9.6</swagger-bootstrap-ui>
		<apollo-version>2.0.1</apollo-version>
		<disruptor-version>3.3.7</disruptor-version>
		<log4j2-version>2.24.0</log4j2-version>
		<mapstruct.version>1.5.5.Final</mapstruct.version>
		<hutool.version>5.8.27</hutool.version>
		<projectlombok.version>1.18.30</projectlombok.version>
		<jpa.version>3.2.5</jpa.version>
		<mysql-connector.version>8.3.0</mysql-connector.version>
		<commons-collections4.version>4.4</commons-collections4.version>
		<javax.servlet-api.version>4.0.1</javax.servlet-api.version>
		<spring-context.version>5.3.22</spring-context.version>
		<!-- framework -->
		<framework-commons.verison>2.5.1-SNAPSHOT</framework-commons.verison>
		<framework-context.verison>2.5.1-SNAPSHOT</framework-context.verison>
		<framework-context-mybatisplugin.verison>2.5.1-SNAPSHOT</framework-context-mybatisplugin.verison>
		<framework-liteflow.verison>2.5.1-SNAPSHOT</framework-liteflow.verison>
		<framework-eventbus.verison>2.5.1-SNAPSHOT</framework-eventbus.verison>
		<framework-service.verison>2.5.1-SNAPSHOT</framework-service.verison>
		<framework-user.verison>2.5.1-SNAPSHOT</framework-user.verison>
        <framework-oss.verison>2.5.1-SNAPSHOT</framework-oss.verison>
        <mall-commons.version>1.0.0</mall-commons.version>
		<mall-distribute-lock.version>1.0.0</mall-distribute-lock.version>
		<mall-redis.version>1.0.0</mall-redis.version>
		<mall-service.version>1.0.0</mall-service.version>
		<xxl-job.version>2.3.1</xxl-job.version>
		<redisson.version>3.18.0</redisson.version>
		<liteflow.version>2.12.4.1</liteflow.version>
		<alittl.version>2.14.0</alittl.version>
		<rocketmq.version>2.2.3</rocketmq.version>
		<rocketmqacl.version>5.0.0</rocketmqacl.version>
		<aliyun-oss.version>3.10.2</aliyun-oss.version>
		<aliyun-java-sdk-core.version>3.2.10</aliyun-java-sdk-core.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-logging</artifactId>
			<exclusions>
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-api</artifactId>
			<version>${log4j2-version}</version>
		</dependency>
		<dependency>
			<groupId>com.lmax</groupId>
			<artifactId>disruptor</artifactId>
			<version>${disruptor-version}</version>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>${projectlombok.version}</version>
		</dependency>
	</dependencies>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.apache.logging.log4j</groupId>
				<artifactId>log4j-bom</artifactId>
				<version>${log4j2-version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${spring-boot}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.apache.commons</groupId>
				<artifactId>commons-collections4</artifactId>
				<version>${commons-collections4.version}</version>
			</dependency>
			<dependency>
				<groupId>io.swagger</groupId>
				<artifactId>swagger-annotations</artifactId>
				<version>${swagger-annotations.version}</version>
			</dependency>
			<dependency>
				<groupId>javax.servlet</groupId>
				<artifactId>javax.servlet-api</artifactId>
				<version>${javax.servlet-api.version}</version>
			</dependency>
			<dependency>
				<groupId>org.springframework</groupId>
				<artifactId>spring-context</artifactId>
				<version>${spring-context.version}</version>
			</dependency>
			<dependency>
				<groupId>org.mybatis</groupId>
				<artifactId>mybatis</artifactId>
				<version>${mybatis.version}</version>
			</dependency>
			<dependency>
				<groupId>com.anta</groupId>
				<artifactId>framework-user</artifactId>
				<version>${framework-user.verison}</version>
			</dependency>
			<dependency>
				<groupId>com.anta</groupId>
				<artifactId>framework-service</artifactId>
				<version>${framework-service.verison}</version>
			</dependency>
			<dependency>
				<groupId>com.anta.mall</groupId>
				<artifactId>mall-commons</artifactId>
				<version>${mall-commons.version}</version>
			</dependency>
			<dependency>
				<groupId>com.anta.mall</groupId>
				<artifactId>mall-distribute-lock</artifactId>
				<version>${mall-distribute-lock.version}</version>
			</dependency>
			<dependency>
				<groupId>com.anta.mall</groupId>
				<artifactId>mall-redis</artifactId>
				<version>${mall-redis.version}</version>
			</dependency>
			<dependency>
				<groupId>com.anta.mall</groupId>
				<artifactId>mall-service</artifactId>
				<version>${mall-service.version}</version>
			</dependency>
			<dependency>
				<groupId>org.mapstruct</groupId>
				<artifactId>mapstruct</artifactId>
				<version>${mapstruct.version}</version>
			</dependency>
			<dependency>
				<groupId>org.redisson</groupId>
				<artifactId>redisson-spring-boot-starter</artifactId>
				<version>${redisson.version}</version>
			</dependency>
			<dependency>
				<groupId>com.xuxueli</groupId>
				<artifactId>xxl-job-core</artifactId>
				<version>${xxl-job.version}</version>
			</dependency>
			<dependency>
				<groupId>cn.hutool</groupId>
				<artifactId>hutool-all</artifactId>
				<version>${hutool.version}</version>
			</dependency>

			<!-- 依赖context工程 -->
			<dependency>
				<groupId>com.anta</groupId>
				<artifactId>framework-context</artifactId>
				<version>${framework-context.verison}</version>
			</dependency>
			<!-- 依赖commons工程 -->
			<dependency>
				<groupId>com.anta</groupId>
				<artifactId>framework-commons</artifactId>
				<version>${framework-commons.verison}</version>
			</dependency>
			<!-- 依赖context-mybatisplugin -->
			<dependency>
				<groupId>com.anta</groupId>
				<artifactId>framework-context-mybatisplugin</artifactId>
				<version>${framework-context-mybatisplugin.verison}</version>
			</dependency>
			<dependency>
				<groupId>com.anta</groupId>
				<artifactId>framework-eventbus</artifactId>
				<version>${framework-eventbus.verison}</version>
			</dependency>
			<!-- liteflow -->
			<dependency>
				<groupId>com.yomahub</groupId>
				<artifactId>liteflow-spring-boot-starter</artifactId>
				<version>${liteflow.version}</version>
			</dependency>
			<dependency>
				<groupId>com.yomahub</groupId>
				<artifactId>liteflow-spring</artifactId>
				<version>${liteflow.version}</version>
			</dependency>
			<dependency>
				<groupId>com.yomahub</groupId>
				<artifactId>liteflow-core</artifactId>
				<version>${liteflow.version}</version>
			</dependency>

			<!-- 依赖liteflow -->
			<dependency>
				<groupId>com.anta</groupId>
				<artifactId>framework-liteflow</artifactId>
				<version>${framework-liteflow.verison}</version>
			</dependency>

			<!-- 依赖TTL -->
			<dependency>
				<groupId>com.alibaba</groupId>
				<artifactId>transmittable-thread-local</artifactId>
				<version>${alittl.version}</version> <!-- 使用最新版本 -->
			</dependency>
			
			<dependency>
	            <groupId>org.apache.rocketmq</groupId>
	            <artifactId>rocketmq-spring-boot-starter</artifactId>
	            <version>${rocketmq.version}</version>
	        </dependency>
	        <dependency>
			    <groupId>org.apache.rocketmq</groupId>
			    <artifactId>rocketmq-acl</artifactId>
			    <version>${rocketmqacl.version}</version>
			</dependency>

			<!--framework-oss-->
			<dependency>
				<groupId>com.anta</groupId>
				<artifactId>framework-oss</artifactId>
				<version>${framework-oss.verison}</version>
			</dependency>
			<dependency>
				<groupId>com.aliyun.oss</groupId>
				<artifactId>aliyun-sdk-oss</artifactId>
				<version>${aliyun-oss.version}</version>
			</dependency>
			<dependency>
				<groupId>com.aliyun</groupId>
				<artifactId>aliyun-java-sdk-core</artifactId>
				<version>${aliyun-java-sdk-core.version}</version>
			</dependency>
		</dependencies>

	</dependencyManagement>

	<!--<repositories>
      <repository>
        <id>anta.release</id>
        <name>Anta release</name>
        <url>https://artifactory.antasoc.com/artifactory/jmall-virtual</url>
        <releases>
          <enabled>true</enabled>
        </releases>
        <snapshots>
          <enabled>true</enabled>
        </snapshots>
      </repository>
    </repositories>-->

	<distributionManagement>
		<repository>
			<id>gsmmp-releases</id>
			<name>gsmmp-maven-releases</name>
			<url>https://artifactory.anta.com/artifactory/gsmmp-maven-releases/</url>
		</repository>
		<snapshotRepository>
			<id>gsmmp-snapshots</id>
			<name>gsmmp-maven-snapshots</name>
			<url>https://artifactory.anta.com/artifactory/gsmmp-maven-snapshots</url>
		</snapshotRepository>
	</distributionManagement>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.8.1</version>
				<configuration>
					<target>${jdk.version}</target>
					<source>${jdk.version}</source>
					<encoding>${project.build.sourceEncoding}</encoding>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
